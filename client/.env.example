# Frontend environment variables
# Copy this file to .env.local for local development.
#
# VITE_API_BASE controls where fetch() calls are sent.
#
#   Development  — leave empty. Vite's dev server proxies /assets/* to
#                  http://localhost:3000 automatically (see vite.config.ts).
#
#   Netlify      — leave empty. netlify.toml proxies /assets/* to Railway
#                  server-side, so no env var is needed.
#
#   Other hosts  — set this to your Railway URL if your host doesn't support
#                  proxy redirect rules. The backend must have CORS enabled.
#                  Example: VITE_API_BASE=https://meridian-api.up.railway.app
#
VITE_API_BASE=
